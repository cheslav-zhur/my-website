---
import DevNotice from '../components/DevNotice.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const { title = 'Cheslav Zhuravsky' } = Astro.props;
const googleMeasurementId = 'G-STEZKB0F3L';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{
			import.meta.env.PROD && (
				<>
					<script
						is:inline
						async
						src={`https://www.googletagmanager.com/gtag/js?id=${googleMeasurementId}`}
					/>
					<script
						is:inline
						set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${googleMeasurementId}');`}
					/>
				</>
			)
		}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<style is:inline>
			html.dev-notice-dismissed #dev-notice {
				display: none;
			}
		</style>
		<script is:inline>
			(function () {
				var key = 'dev-notice-dismissed-at';
				var day = 24 * 60 * 60 * 1000;

				function stillDismissed(raw) {
					if (typeof raw !== 'string' || raw.trim() === '') return false;
					var stored = Number(raw);
					if (!Number.isFinite(stored)) return false;
					var now = Date.now();
					if (stored > now) return false;
					return now - stored < day;
				}

				try {
					if (stillDismissed(localStorage.getItem(key))) {
						document.documentElement.classList.add('dev-notice-dismissed');
					}
				} catch (error) {}

				document.addEventListener('click', function (event) {
					var target = event.target;
					if (!target || typeof target.closest !== 'function') return;
					if (!target.closest('[data-dev-notice-close]')) return;
					try {
						localStorage.setItem(key, String(Date.now()));
					} catch (error) {
						return;
					}
					document.documentElement.classList.add('dev-notice-dismissed');
				});
			})();
		</script>
	</head>
	<body class="min-h-screen bg-bg text-fg antialiased">
		<DevNotice />
		<SiteHeader />
		<div class="mx-auto w-full max-w-3xl px-4 py-8">
			<slot />
		</div>
	</body>
</html>

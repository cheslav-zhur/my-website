---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { includeInSite } from '../../lib/publish';

const notes = await getCollection('notes', ({ data }) => includeInSite(data));
const sortedNotes = [...notes].sort((a, b) => {
	const ad = String(a.data.date ?? '');
	const bd = String(b.data.date ?? '');
	return bd.localeCompare(ad);
});
---

<Layout title="Notes — Cheslav Zhuravsky">
	<main class="space-y-6">
		<h1 class="font-display text-3xl font-bold">Notes</h1>

		{sortedNotes.length === 0 ? (
			<p class="text-muted">
				No notes yet. Add a markdown file to <code>content/notes/</code>.
			</p>
		) : (
			<ul class="space-y-3">
				{sortedNotes.map((note) => {
					const slug = String(note.id);
					return (
						<li class="rounded-card border border-border bg-surface px-4 py-3">
							<a href={`/notes/${slug}/`} class="font-medium no-underline hover:text-accent">
								{String(note.data.title ?? slug)}
							</a>
						</li>
					);
				})}
			</ul>
		)}
	</main>
</Layout>
